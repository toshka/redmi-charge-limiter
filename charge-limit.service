[Unit]
Description=Set battery charge limit on boot
# Re-run when AC adapter is connected (see charge-limit-ac.rules)
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/set_charge_limit.sh enable
# Stopping the unit lifts the limit, so `systemctl stop` is a real off switch.
# This is what the GNOME Quick Settings toggle drives.
ExecStop=/usr/local/bin/set_charge_limit.sh disable
RemainAfterExit=yes
User=root

[Install]
WantedBy=multi-user.target
